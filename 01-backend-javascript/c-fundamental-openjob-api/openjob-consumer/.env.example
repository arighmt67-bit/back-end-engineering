# Konfigurasi PostgreSQL (dibaca bersama dengan openjob-api)
PGUSER=<user_postgres>
PGPASSWORD=<password_postgres>
PGDATABASE=openjob
PGHOST=localhost
PGPORT=5432

# Konfigurasi RabbitMQ (Message Broker)
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest

# Konfigurasi Email (Nodemailer)
# MAIL_PASSWORD wajib berupa App Password 16 karakter dari akun Google ber-2FA,
# bukan kata sandi akun biasa.
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=<alamat_email_pengirim>
MAIL_PASSWORD=<app_password_gmail>
