# Konfigurasi HTTP Server
HOST=localhost
PORT=3000

# Konfigurasi PostgreSQL
PGUSER=<user_postgres>
PGPASSWORD=<passw...res>
PGDATABASE=openjob
PGHOST=localhost
PGPORT=5432

# Konfigurasi JWT Token
ACCESS_TOKEN_KEY=<kunci...ess>
REFRESH_TOKEN_KEY=<kunci_rahasia_refresh>
ACCESS_TOKEN_AGE=1800

# Konfigurasi Redis (Caching)
REDIS_HOST=localhost
REDIS_PORT=6379

# Konfigurasi RabbitMQ (Message Broker)
# Pesan lamaran baru diterbitkan ke antrean dan diproses oleh project openjob-consumer.
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=***
