# Salin berkas ini menjadi .env, lalu sesuaikan nilainya bila diperlukan.
# Keduanya OPSIONAL — aplikasi tetap berjalan dengan nilai bawaan tanpa berkas ini.
# Nilai dibaca dari environment variable, contoh:
#   export SECRET_KEY="ganti-dengan-kunci-rahasia-anda"
#   export DEBUG=True

# Kunci rahasia Django. Bawaan: kunci pengembangan lokal.
SECRET_KEY=ganti-dengan-kunci-rahasia-anda

# Mode debug. Bawaan: False (respons error tetap berformat JSON).
DEBUG=False
