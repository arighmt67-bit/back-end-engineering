SECRET_KEY=your-django-secret-key
DEBUG=True

# Kriteria 1 (Versi 1): kredensial PostgreSQL
DATABASE_NAME=dicoevent
DATABASE_USER=postgres
DATABASE_PASSWORD=your-database-password
DATABASE_HOST=localhost
DATABASE_PORT=5432

# Kriteria 1: kredensial Minio (pengelolaan berkas media)
MINIO_ENDPOINT_URL=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=dicoevent

# Kriteria 2: kredensial Redis (caching)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# Kriteria 3: kredensial Celery (asynchronous task)
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# Kriteria 3: kredensial email pengiriman reminder
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USER=
MAIL_PASSWORD=
MAIL_USE_TLS=False
MAIL_FROM=no-reply@dicoevent.test

# Opsional: backend email Django (biarkan default untuk SMTP sungguhan)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend

# Opsional: jalankan task Celery secara sinkron (untuk pengujian tanpa worker)
CELERY_TASK_ALWAYS_EAGER=False
